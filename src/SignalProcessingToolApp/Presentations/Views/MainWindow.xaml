<Window x:Class="SignalProcessingToolApp.Presentations.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SignalProcessingToolApp.Presentations.Views"
        xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="信号処理アプリケーション" Height="700" Width="1000">

    <Window.Resources>
        <!-- int を bool に変換するコンバーター（パラメータと一致したら true） -->
        <local:EqualityConverter x:Key="EqualityConverter"/>

        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,20,6"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Height" Value="30"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="#C8E6C9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#E0E0E0"/>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#C8E6C9"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E0E0E0"/>
                    <Setter Property="Foreground" Value="#808080"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左列：入力パラメータ -->
        <StackPanel Grid.Column="0" Margin="10,10,10,0" VerticalAlignment="Top" Grid.IsSharedSizeScope="True" IsEnabled="{Binding IsParametersEnabled}">
            <!-- 0行：共通パラメータ -->
            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="共通パラメータ" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" SharedSizeGroup="ParamLabel"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="サンプリング周波数 [Hz]:"/>
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                           Style="{StaticResource ChangingColorComboxStyle}"
                                           ItemsSource="{Binding CommonParamVm.SamplingFrequencies}"
                          SelectedIndex="{Binding CommonParamVm.SamplingFrequencyIndex}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="フレームサイズ [Sample]:"/>
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                           Style="{StaticResource ChangingColorComboxStyle}"
                                           ItemsSource="{Binding CommonParamVm.FrameSizes}"
                          SelectedIndex="{Binding CommonParamVm.FrameSizeIndex}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="データサイズ [Sample]:"/>
                        <ComboBox Grid.Row="2" Grid.Column="1"
                                           Style="{StaticResource ChangingColorComboxStyle}"
                                           ItemsSource="{Binding CommonParamVm.DataSizes}"
                          SelectedIndex="{Binding CommonParamVm.DataSizeIndex}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 1行：入力信号 -->
            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="入力信号" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="240"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 0行0列：ラジオボタン「正弦波」 -->
                        <RadioButton Grid.Row="0" Grid.Column="0" Content="正弦波" 
                             IsChecked="{Binding Path=WaveformVm.WaveformTypeIndex, Converter={StaticResource EqualityConverter}, ConverterParameter=0}"
                             VerticalAlignment="Center"/>

                        <!-- 0行1列：正弦波周波数パラメータ -->
                        <Grid Grid.Row="0" Grid.Column="1" IsEnabled="{Binding WaveformVm.IsWaveformSineWave}" HorizontalAlignment="Right">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="正弦波周波数 [Hz]:"/>
                            <ComboBox Grid.Column="1"
                                                   Style="{StaticResource ChangingColorComboxStyle}"
                                                   ItemsSource="{Binding WaveformVm.SineWaveFrequencies}"
                              SelectedIndex="{Binding WaveformVm.FrequencyIndex}"/>
                        </Grid>

                        <!-- 1行0列：ラジオボタン「インパルス」 -->
                        <RadioButton Grid.Row="1" Grid.Column="0" Content="インパルス" 
                                 IsChecked="{Binding Path=WaveformVm.WaveformTypeIndex, Converter={StaticResource EqualityConverter}, ConverterParameter=1}"
                                 VerticalAlignment="Center" Margin="0,5,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2行：信号処理 -->
            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="信号処理" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                    <StackPanel Margin="0,0,0,10">
                        <CheckBox Content="ゲインを適用" IsChecked="{Binding SignalConfigVm.IsGainEnabled}" VerticalAlignment="Center" Margin="0,0,0,5"/>

                        <Grid IsEnabled="{Binding SignalConfigVm.IsGainEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" SharedSizeGroup="ParamLabel"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="ゲイン値 [dB]:"/>
                            <ComboBox Grid.Column="1"
                              Style="{StaticResource ChangingColorComboxStyle}"
                              ItemsSource="{Binding SignalConfigVm.GainValues}"
                              SelectedIndex="{Binding SignalConfigVm.GainIndex}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel>
                        <CheckBox Content="ディレイを適用" IsChecked="{Binding SignalConfigVm.IsDelayEnabled}" VerticalAlignment="Center"/>

                        <Grid IsEnabled="{Binding SignalConfigVm.IsDelayEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" SharedSizeGroup="ParamLabel"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ディレイバッファサイズ [Sample]:"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SignalConfigVm.DelayBufferSizeText}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="ディレイサンプル数 [Sample]:"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SignalConfigVm.DelaySampleCountText}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 右列：ボタンとグラフ -->
        <Grid Grid.Column="1" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 0行：操作ボタンとステータス -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10" VerticalAlignment="Top" Height="Auto">
                <Button Content="フレーム処理"
                        Command="{Binding FrameProcessCommand}"
                        Width="100"
                        ToolTip="フレームサイズ分ずつ生成"/>
                <Button Content="一括処理"
                        Command="{Binding BatchProcessCommand}"
                        Width="100"
                        IsEnabled="{Binding IsBatchProcessEnabled}"
                        ToolTip="データサイズ分を一括生成"/>
                <Button Content="リセット"
                        Command="{Binding ResetCommand}"
                        Width="100"
                        ToolTip="プロットをリセット"/>
                <Border BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="15,0,0,0"
                        Padding="12,8,12,8"
                        Width="250"
                        Height="50"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="11"
                               Foreground="#333333"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               LineHeight="20"/>
                </Border>
            </StackPanel>

            <!-- 1行・2行：波形グラフ -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="Black"
                        BorderThickness="1"
                        Background="White"
                        Margin="10,10,10,5">
                    <scottplot:WpfPlot x:Name="waveformPlot"/>
                </Border>

                <Border Grid.Row="1"
                        BorderBrush="Black"
                        BorderThickness="1"
                        Background="White"
                        Margin="10,5,10,10">
                    <scottplot:WpfPlot x:Name="gainedWaveformPlot"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>